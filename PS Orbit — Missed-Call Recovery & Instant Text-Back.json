    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst output = [];\n\nfor (const item of items) {\n  const data = item.json.body || item.json;\n\n  // Telephony call status can be no-answer, busy, canceled, or completed with 0s duration\n  const callStatus = (data.CallStatus || data.call_status || '').toLowerCase();\n  const duration = parseInt(data.CallDuration || data.duration || '0', 10);\n  const callerNumber = data.From || data.caller || '+15125550198';\n  const dialedNumber = data.To || data.forwarded_to || '+15128889900';\n\n  const isMissedCall = ['no-answer', 'busy', 'canceled'].includes(callStatus) || (callStatus === 'completed' && duration === 0);\n\n  if (isMissedCall) {\n    // Generate unique recovery tracking ID\n    const recoveryId = 'rec_' + Math.random().toString(36).substring(2, 9);\n    const timestamp = new Date().toISOString();\n\n    // Standardized instant SMS recovery copy\n    const smsMessage = `Hi, this is Marcus with Orbit Realty. Sorry I missed your call! I am currently assisting a buyer—are you calling regarding a specific property listing or scheduling a tour?`;\n\n    output.push({\n      json: {\n        recovery_id: recoveryId,\n        timestamp: timestamp,\n        caller_number: callerNumber,\n        dialed_number: dialedNumber,\n        call_status: callStatus,\n        call_duration: duration,\n        recovery_sms_body: smsMessage,\n        escalation_priority: 'HIGH_URGENT_MISSED_CALL',\n        follow_up_stage: 'Stage 0',\n        lead_status: 'Active',\n        next_follow_up_date: timestamp.split('T')[0] // Due today\n      }\n    });\n  }\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "b7261a8c-1401-4b07-8b0b-7aac2c419cb4",
