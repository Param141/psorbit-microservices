{
  "name": "PS Orbit — Missed-Call Recovery & Instant Text-Back",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "telephony/call-status",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
