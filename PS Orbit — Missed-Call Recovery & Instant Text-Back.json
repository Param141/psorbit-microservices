    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "=🚨 **MISSED CALL RECOVERY FIRED**\n**Caller:** `{{ $json.caller_number }}`\n**Status:** `{{ $json.call_status }}` (Duration: {{ $json.call_duration }}s)\n**Escalation:** {{ $json.escalation_priority }}\n\n📱 **Automated Recovery SMS Sent:**\n> \"{{ $json.recovery_sms_body }}\"\n\n⚡ **Action Required:** Tap below to call back now.\ntel:{{ $json.caller_number }}",
        "options": {}
